# --- Database ---
POSTGRES_DB=db_name
POSTGRES_USER=db_user
POSTGRES_PASSWORD=db_pass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- JWT (local development: file paths) ---
JWT_PRIVATE_KEY=C:/Users/Juan/private_key.pem
JWT_PUBLIC_KEY=C:/Users/Juan/public_key.pem

# --- JWT (production: Base64-encoded PEM content, no line breaks) ---
# Generate with: base64 -w 0 private_key.pem
# JWT_PRIVATE_KEY_BASE64=<paste-base64-private-key-here>
# Generate with: base64 -w 0 public_key.pem
# JWT_PUBLIC_KEY_BASE64=<paste-base64-public-key-here>

# --- CORS (production) ---
# CORS_ALLOWED_ORIGINS=https://your-netlify-app.netlify.app

# --- Spring Profile (production) ---
# SPRING_PROFILES_ACTIVE=prod
